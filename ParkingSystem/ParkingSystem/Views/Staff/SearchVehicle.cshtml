@model List<ParkingSystem.Models.ParkingLog>
@{ ViewData["Title"] = "Tìm kiếm xe"; }

<h3 class="fw-bold mb-4"><i class="fas fa-search"></i> Tìm kiếm phương tiện</h3>

<div class="card mb-4">
    <div class="card-body">
        <form asp-controller="Staff" asp-action="SearchVehicle" method="get" class="row g-3 align-items-end">
            <div class="col-md-8">
                <label class="form-label fw-bold">Biển số xe:</label>
                <input type="text" name="query" value="@ViewData["Query"]" class="form-control text-uppercase" placeholder="Nhập biển số xe cần tìm..." />
            </div>
            <div class="col-md-4">
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary fw-bold"><i class="fas fa-search"></i> Tìm kiếm</button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (ViewData["Query"] != null)
{
    <div class="card">
        <div class="card-header bg-dark text-white fw-bold">
            <i class="fas fa-list"></i> Kết quả tìm kiếm: @Model.Count bản ghi
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Biển Số</th>
                            <th>Loại Xe</th>
                            <th>Thời Gian Vào</th>
                            <th>Thời Gian Ra</th>
                            <th>Phí</th>
                            <th>Trạng Thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td><span class="plate-badge">@log.PlateNumber</span></td>
                                <td>
                                    @if (log.VehicleType == "Car")
                                    { <span class="text-danger"><i class="fas fa-car"></i> Ô Tô</span> }
                                    else
                                    { <span class="text-success"><i class="fas fa-motorcycle"></i> Xe Máy</span> }
                                </td>
                                <td>@log.TimeIn.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@(log.TimeOut?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                                <td>@(log.Fee.HasValue ? $"{log.Fee:N0} VND" : "—")</td>
                                <td>
                                    @if (log.Status == "Inside")
                                    { <span class="badge badge-status-inside">Trong bãi</span> }
                                    else
                                    { <span class="badge badge-status-outside">Đã ra</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
