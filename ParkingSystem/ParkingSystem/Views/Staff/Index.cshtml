@model StaffDashboardViewModel
@{ ViewData["Title"] = "Bảng Điều Khiển - Staff"; }

<div id="parkingStatusContainer">
    <partial name="_AlertFull" model="Model.ParkingStatus" />
</div>

<div class="row">
    <div class="col-lg-4 col-md-5 mb-4">
        <div id="parkingStatusContainer">
            <partial name="_ParkingStatus" model="Model.ParkingStatus" />
        </div>

        <div class="card">
            <div class="card-header bg-success text-white fw-bold">
                <i class="fas fa-sign-in-alt"></i> GHI NHẬN XE VÀO BÃI
            </div>
            <div class="card-body">
                <form asp-controller="Staff" asp-action="CheckIn" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="CheckInForm.PlateNumber" class="form-label fw-bold">Biển số xe:</label>
                        <input asp-for="CheckInForm.PlateNumber" class="form-control text-uppercase fw-bold" placeholder="Ví dụ: 29A12345" />
                        <span asp-validation-for="CheckInForm.PlateNumber" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CheckInForm.VehicleType" class="form-label fw-bold">Loại phương tiện:</label>
                        <select asp-for="CheckInForm.VehicleType" class="form-select">
                            <option value="Motorbike">🏍️ Xe Máy</option>
                            <option value="Car">🚗 Ô Tô</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CheckInForm.ZoneId" class="form-label fw-bold">Chọn phân khu đỗ:</label>
                        <select asp-for="CheckInForm.ZoneId" class="form-select">
                            @foreach (var zone in Model.Zones)
                            {
                                <option value="@zone.ZoneId">@zone.ZoneName</option>
                            }
                        </select>
                        <span asp-validation-for="CheckInForm.ZoneId" class="text-danger small"></span>
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-success fw-bold py-2">
                            <i class="fas fa-plus-circle"></i> XÁC NHẬN CHO XE VÀO
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-8 col-md-7">
        <div class="card mb-4">
            <div class="card-header bg-warning text-dark fw-bold d-flex justify-content-between align-items-center">
                <span><i class="fas fa-hourglass-half"></i> DANH SÁCH XE ĐANG CHỜ DUYỆT</span>
                <span class="badge bg-danger">@Model.WaitingLogs.Count xe chờ</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>STT</th>
                                <th>Biển Số Xe</th>
                                <th>Loại Xe</th>
                                <th>Thời Gian Yêu Cầu</th>
                                <th class="text-center">Hành Động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.WaitingLogs.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        Không có xe nào đang trong bãi chờ.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                int stt = 1;
                                foreach (var item in Model.WaitingLogs)
                                {
                                    <tr>
                                        <td>@(stt++)</td>
                                        <td><span class="plate-badge">@item.PlateNumber</span></td>
                                        <td>
                                            @if (item.VehicleType == "Car")
                                            {
                                                <span class="text-danger fw-bold"><i class="fas fa-car"></i> Ô Tô</span>
                                            }
                                            else
                                            {
                                                <span class="text-success fw-bold"><i class="fas fa-motorcycle"></i> Xe Máy</span>
                                            }
                                        </td>
                                        <td>@item.TimeIn.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-center">
                                            <form asp-controller="Staff" asp-action="ApproveCheckIn" asp-route-id="@item.LogId" method="post"
                                                  class="d-flex align-items-center justify-content-center gap-2"
                                                  onsubmit="return confirm('Duyệt cho xe @item.PlateNumber vào bãi?');">
                                                @Html.AntiForgeryToken()
                                                <select name="zoneId" class="form-select form-select-sm border-success text-dark fw-bold" style="width: auto;" required>
                                                    @foreach (var zone in Model.Zones)
                                                    {
                                                        <option value="@zone.ZoneId">@zone.ZoneName</option>
                                                    }
                                                </select>
                                                <button type="submit" class="btn btn-success btn-sm rounded-pill px-3 fw-bold text-nowrap">
                                                    <i class="fas fa-check-circle"></i> Duyệt Vào
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="card">
            <div class="card-header bg-dark text-white fw-bold d-flex justify-content-between align-items-center">
                <span><i class="fas fa-list"></i> XE ĐANG TRONG BÃI</span>
                <span class="badge bg-light text-dark">@Model.InsideVehicles.Count phương tiện</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>STT</th>
                                <th>Biển Số Xe</th>
                                <th>Loại Xe</th>
                                <th>Thời Gian Vào</th>
                                <th>Phân Khu</th>
                                <th>Vé Tháng</th>
                                <th class="text-center">Hành Động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.InsideVehicles.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-5">
                                        <i class="fas fa-folder-open fa-3x d-block mb-2"></i>
                                        Không có phương tiện nào trong bãi.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                int stt = 1;
                                foreach (var item in Model.InsideVehicles)
                                {
                                    <tr>
                                        <td>@(stt++)</td>
                                        <td><span class="plate-badge">@item.PlateNumber</span></td>
                                        <td>
                                            @if (item.VehicleType == "Car")
                                            {
                                                <span class="text-danger fw-bold"><i class="fas fa-car"></i> Ô Tô</span>
                                            }
                                            else
                                            {
                                                <span class="text-success fw-bold"><i class="fas fa-motorcycle"></i> Xe Máy</span>
                                            }
                                        </td>
                                        <td>@item.TimeIn.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            <span class="badge bg-light text-dark border px-2 py-1"><i class="fas fa-layer-group text-primary me-1"></i>@(item.Zone?.ZoneName ?? "Chưa rõ")</span>
                                        </td>
                                        <td>
                                            @if (item.IsMonthlyPass)
                                            {
                                                <span class="badge bg-info"><i class="fas fa-id-card"></i> Vé tháng</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Vãng lai</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <form asp-controller="Staff" asp-action="CheckOut" asp-route-id="@item.LogId" method="post"
                                                  onsubmit="return confirm('Xác nhận cho xe @item.PlateNumber xuất bãi?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                                    <i class="fas fa-money-bill-wave"></i> Tính tiền & Ra
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
