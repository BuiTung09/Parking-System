@{ ViewData["Title"] = "Truy cập bị từ chối"; }

<div class="container text-center py-5">
    <i class="fas fa-ban text-danger" style="font-size: 5rem;"></i>
    <h2 class="mt-4 text-danger fw-bold">Truy cập bị từ chối!</h2>
    <p class="text-muted">Bạn không có quyền truy cập trang này. Vui lòng liên hệ quản trị viên.</p>
    <a asp-controller="Account" asp-action="Login" class="btn btn-primary mt-3">
        <i class="fas fa-arrow-left"></i> Quay lại đăng nhập
    </a>
</div>
