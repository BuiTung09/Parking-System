@model List<ZoneStatusViewModel>
@{
    ViewData["Title"] = "Quản lý Phân khu";
    ViewData["ActivePage"] = "ManageZones";
    var configCarTotal = (int)(ViewData["ConfigCarTotal"] ?? 0);
    var configBikeTotal = (int)(ViewData["ConfigBikeTotal"] ?? 0);
    var zoneCarTotal = (int)(ViewData["ZoneCarTotal"] ?? 0);
    var zoneBikeTotal = (int)(ViewData["ZoneBikeTotal"] ?? 0);
    var remainingCar = (int)(ViewData["RemainingCarSlots"] ?? 0);
    var remainingBike = (int)(ViewData["RemainingBikeSlots"] ?? 0);
    bool overCar = zoneCarTotal > configCarTotal;
    bool overBike = zoneBikeTotal > configBikeTotal;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-dark"><i class="fas fa-th-large text-primary me-2"></i> Quản lý phân khu đỗ xe</h3>
    <a asp-action="CreateZone" class="btn btn-success fw-bold py-2 rounded-3 shadow-sm">
        <i class="fas fa-plus-circle me-1"></i> Thêm phân khu mới
    </a>
</div>

<!-- BUDGET SUMMARY -->
<div class="alert @((overCar || overBike) ? "alert-danger" : "alert-info") border-0 shadow-sm mb-4 small py-3 rounded-3">
    <div class="row align-items-center">
        <div class="col-md-8">
            <i class="fas fa-@((overCar || overBike) ? "exclamation-triangle" : "info-circle") me-2"></i>
            <strong>Giới hạn cấu hình toàn bãi:</strong>
            <span class="ms-2">
                Ô tô: <strong class="@(overCar ? "text-danger" : "")">@zoneCarTotal / @configCarTotal slot</strong> đã phân bổ
                &nbsp;|&nbsp;
                Xe máy: <strong class="@(overBike ? "text-danger" : "")">@zoneBikeTotal / @configBikeTotal slot</strong> đã phân bổ
            </span>
            @if (overCar || overBike)
            {
                <div class="mt-1 text-danger"><i class="fas fa-exclamation-triangle me-1"></i>Tổng slot phân khu đang vượt quá giới hạn cấu hình! Hãy chỉnh sửa các phân khu.</div>
            }
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="ParkingConfig" class="btn btn-sm btn-outline-@((overCar || overBike) ? "danger" : "primary") rounded-3">
                <i class="fas fa-cogs me-1"></i>Chỉnh cấu hình tổng
            </a>
        </div>
    </div>
</div>

<!-- THỐNG KÊ PHÂN KHU -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 bg-primary text-white shadow-sm rounded-3">
            <div class="card-body p-4 d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-white-50 text-uppercase fw-bold mb-1 small">Tổng phân khu</h6>
                    <h2 class="fw-bold mb-0 display-6">@Model.Count</h2>
                </div>
                <div class="fs-1 text-white-50"><i class="fas fa-layer-group"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 @(overCar ? "bg-danger" : "bg-danger") text-white shadow-sm rounded-3">
            <div class="card-body p-4 d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-white-50 text-uppercase fw-bold mb-1 small">Ô tô đã phân bổ</h6>
                    <h2 class="fw-bold mb-0 display-6">@zoneCarTotal <small class="fs-6 text-white-50">/ @configCarTotal</small></h2>
                    @if (remainingCar > 0)
                    {
                        <small class="text-white-50">Còn: @remainingCar slot chưa phân bổ</small>
                    }
                    else if (overCar)
                    {
                        <small class="text-warning"><i class="fas fa-exclamation-triangle"></i> Vượt giới hạn!</small>
                    }
                    else
                    {
                        <small class="text-white-50">Đã phân bổ đủ</small>
                    }
                </div>
                <div class="fs-1 text-white-50"><i class="fas fa-car"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 bg-success text-white shadow-sm rounded-3">
            <div class="card-body p-4 d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-white-50 text-uppercase fw-bold mb-1 small">Xe máy đã phân bổ</h6>
                    <h2 class="fw-bold mb-0 display-6">@zoneBikeTotal <small class="fs-6 text-white-50">/ @configBikeTotal</small></h2>
                    @if (remainingBike > 0)
                    {
                        <small class="text-white-50">Còn: @remainingBike slot chưa phân bổ</small>
                    }
                    else if (overBike)
                    {
                        <small class="text-warning"><i class="fas fa-exclamation-triangle"></i> Vượt giới hạn!</small>
                    }
                    else
                    {
                        <small class="text-white-50">Đã phân bổ đủ</small>
                    }
                </div>
                <div class="fs-1 text-white-50"><i class="fas fa-motorcycle"></i></div>
            </div>
        </div>
    </div>
</div>

<!-- DANH SÁCH CHI TIẾT -->
<div class="card shadow-sm border-0 rounded-3">
    <div class="card-header bg-white border-bottom py-3">
        <h5 class="mb-0 fw-bold text-dark"><i class="fas fa-list text-muted me-2"></i>Danh sách phân khu đỗ xe</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-4">Tên phân khu</th>
                        <th>Trạng thái Ô tô</th>
                        <th>Trạng thái Xe máy</th>
                        <th>Mô tả</th>
                        <th class="text-center pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var zone in Model)
                        {
                            var carPercent = zone.TotalCarSlots > 0 ? (double)zone.CurrentCarCount / zone.TotalCarSlots * 100 : 0;
                            var bikePercent = zone.TotalBikeSlots > 0 ? (double)zone.CurrentBikeCount / zone.TotalBikeSlots * 100 : 0;
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark fs-5">@zone.ZoneName</div>
                                    <small class="text-muted">Mã khu: #@zone.ZoneId</small>
                                </td>
                                <td style="width: 25%;">
                                    <div class="d-flex justify-content-between align-items-center mb-1 small">
                                        <span class="text-muted">Đang đỗ: <strong>@zone.CurrentCarCount/@zone.TotalCarSlots</strong></span>
                                        <span class="fw-semibold text-danger">@carPercent.ToString("N0")%</span>
                                    </div>
                                    <div class="progress" style="height: 6px; border-radius: 3px;">
                                        <div class="progress-bar bg-danger" role="progressbar" style="width: @carPercent%"></div>
                                    </div>
                                </td>
                                <td style="width: 25%;">
                                    <div class="d-flex justify-content-between align-items-center mb-1 small">
                                        <span class="text-muted">Đang đỗ: <strong>@zone.CurrentBikeCount/@zone.TotalBikeSlots</strong></span>
                                        <span class="fw-semibold text-success">@bikePercent.ToString("N0")%</span>
                                    </div>
                                    <div class="progress" style="height: 6px; border-radius: 3px;">
                                        <div class="progress-bar bg-success" role="progressbar" style="width: @bikePercent%"></div>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted">@(zone.Description ?? "—")</span>
                                </td>
                                <td class="text-center pe-4">
                                    <div class="d-flex justify-content-center align-items-center gap-2">
                                        <a asp-action="EditZone" asp-route-id="@zone.ZoneId" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            <i class="fas fa-edit me-1"></i>Sửa
                                        </a>
                                        <form asp-action="DeleteZone" asp-route-id="@zone.ZoneId" method="post" class="d-inline"
                                              onsubmit="return confirm('Bạn chắc chắn muốn xóa phân khu @zone.ZoneName?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                <i class="fas fa-trash me-1"></i>Xóa
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <div class="mb-3 fs-1 text-light"><i class="fas fa-folder-open"></i></div>
                                <h5 class="fw-bold">Chưa có phân khu đỗ xe nào</h5>
                                <p class="small text-secondary mb-0">Nhấn nút "Thêm phân khu mới" phía trên để bắt đầu cấu hình.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
