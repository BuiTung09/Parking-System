@model RevenueReportViewModel
@{ ViewData["Title"] = "Báo cáo doanh thu"; ViewData["ActivePage"] = "RevenueReport"; }

<h3 class="fw-bold mb-4"><i class="fas fa-chart-bar"></i> Báo cáo doanh thu</h3>

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="RevenueReport" method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-bold">Kỳ báo cáo:</label>
                <select name="period" class="form-select">
                    <option value="day" selected="@(Model.Period == "day")">Theo ngày</option>
                    <option value="week" selected="@(Model.Period == "week")">Theo tuần</option>
                    <option value="month" selected="@(Model.Period == "month")">Theo tháng</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Từ ngày:</label>
                <input type="date" name="from" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Đến ngày:</label>
                <input type="date" name="to" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-3">
                <div class="d-grid"><button type="submit" class="btn btn-primary fw-bold"><i class="fas fa-filter"></i> Lọc</button></div>
            </div>
        </form>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="stat-card card bg-success text-white text-center">
            <div class="card-body">
                <h6>TỔNG DOANH THU</h6>
                <h3 class="fw-bold">@Model.TotalRevenue.ToString("N0") VND</h3>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="stat-card card bg-info text-white text-center">
            <div class="card-body">
                <h6>TỔNG GIAO DỊCH</h6>
                <h3 class="fw-bold">@Model.TotalTransactions</h3>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-dark text-white fw-bold"><i class="fas fa-chart-bar"></i> Biểu đồ doanh thu</div>
    <div class="card-body"><canvas id="revenueChart" height="100"></canvas></div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        new Chart(document.getElementById('revenueChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Labels)),
                datasets: [
                    { label: 'Doanh thu (VND)', data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueData)), backgroundColor: 'rgba(25,135,84,0.7)', borderRadius: 6 },
                    { label: 'Ô tô (lượt)', data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CarData)), backgroundColor: 'rgba(220,53,69,0.5)', borderRadius: 4 },
                    { label: 'Xe máy (lượt)', data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BikeData)), backgroundColor: 'rgba(13,110,253,0.5)', borderRadius: 4 }
                ]
            },
            options: { responsive: true, scales: { y: { beginAtZero: true } } }
        });
    </script>
}
