@model RevenueReportViewModel
@{ ViewData["Title"] = "Báo cáo lưu lượng"; ViewData["ActivePage"] = "TrafficReport"; }

<h3 class="fw-bold mb-4"><i class="fas fa-chart-line"></i> Báo cáo lưu lượng xe</h3>

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="TrafficReport" method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-bold">Từ ngày:</label>
                <input type="date" name="from" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold">Đến ngày:</label>
                <input type="date" name="to" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-4">
                <div class="d-grid"><button type="submit" class="btn btn-primary fw-bold"><i class="fas fa-filter"></i> Lọc</button></div>
            </div>
        </form>
    </div>
</div>

<div class="row">
    <div class="col-md-8 mb-4">
        <div class="card">
            <div class="card-header bg-dark text-white fw-bold"><i class="fas fa-chart-line"></i> Tần suất xe vào bãi</div>
            <div class="card-body"><canvas id="trafficChart" height="100"></canvas></div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card">
            <div class="card-header bg-dark text-white fw-bold"><i class="fas fa-chart-pie"></i> Tỷ lệ loại xe</div>
            <div class="card-body"><canvas id="pieChart"></canvas></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        var labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Labels));
        var carData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CarData));
        var bikeData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BikeData));

        new Chart(document.getElementById('trafficChart'), {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    { label: 'Ô tô', data: carData, borderColor: '#dc3545', backgroundColor: 'rgba(220,53,69,0.1)', tension: 0.3, fill: true },
                    { label: 'Xe máy', data: bikeData, borderColor: '#198754', backgroundColor: 'rgba(25,135,84,0.1)', tension: 0.3, fill: true }
                ]
            },
            options: { responsive: true, scales: { y: { beginAtZero: true } } }
        });

        var totalCar = carData.reduce(function(a, b) { return a + b; }, 0);
        var totalBike = bikeData.reduce(function(a, b) { return a + b; }, 0);
        new Chart(document.getElementById('pieChart'), {
            type: 'doughnut',
            data: {
                labels: ['Ô tô', 'Xe máy'],
                datasets: [{ data: [totalCar, totalBike], backgroundColor: ['#dc3545', '#198754'] }]
            }
        });
    </script>
}
