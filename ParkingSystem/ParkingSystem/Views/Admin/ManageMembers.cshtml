@model List<MemberListViewModel>
@{ ViewData["Title"] = "Manage Member"; ViewData["ActivePage"] = "ManageMembers"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold"><i class="fas fa-users"></i> Quản lý tài khoản thành viên</h3>
    <a asp-action="CreateMember" class="btn btn-success fw-bold"><i class="fas fa-user-plus"></i> Tạo tài khoản mới</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Họ tên</th>
                        <th>Điện thoại</th>
                        <th>Email</th>
                        <th>Số xe</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Chưa có tài khoản thành viên nào.</td>
                        </tr>
                    }
                    @foreach (var member in Model)
                    {
                        <tr>
                            <td class="fw-bold">@member.FullName</td>
                            <td>@(member.PhoneNumber ?? "—")</td>
                            <td>@member.Email</td>
                            <td>@member.VehicleCount</td>
                            <td>
                                @if (member.IsActive)
                                { <span class="badge bg-success rounded-pill">Hoạt động</span> }
                                else
                                { <span class="badge bg-danger rounded-pill">Đã khóa</span> }
                            </td>
                            <td>@member.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                <form asp-action="ToggleMember" asp-route-id="@member.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('@(member.IsActive ? "Khóa" : "Mở khóa") tài khoản @member.FullName?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(member.IsActive ? "btn-outline-danger" : "btn-outline-success") rounded-pill px-3">
                                        <i class="fas fa-@(member.IsActive ? "lock" : "unlock")"></i>
                                        @(member.IsActive ? "Khóa" : "Mở khóa")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
