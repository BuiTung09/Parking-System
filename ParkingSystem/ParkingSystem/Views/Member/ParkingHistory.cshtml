@model List<ParkingLog>
@{ ViewData["Title"] = "Lịch sử gửi xe"; }

<h3 class="fw-bold mb-4"><i class="fas fa-history"></i> Lịch sử gửi xe</h3>

@{
    var vehicles = ViewData["Vehicles"] as List<Vehicle> ?? new List<Vehicle>();
    var selectedId = ViewData["SelectedVehicleId"] as int?;
}

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="ParkingHistory" method="get" class="row g-3 align-items-end">
            <div class="col-md-8">
                <label class="form-label fw-bold">Lọc theo xe:</label>
                <select name="vehicleId" class="form-select">
                    <option value="">-- Tất cả xe --</option>
                    @foreach (var v in vehicles)
                    {
                        <option value="@v.VehicleId" selected="@(selectedId == v.VehicleId)">@v.PlateNumber (@(v.VehicleType == "Car" ? "Ô Tô" : "Xe Máy"))</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <div class="d-grid"><button type="submit" class="btn btn-primary fw-bold"><i class="fas fa-filter"></i> Lọc</button></div>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header bg-dark text-white fw-bold"><i class="fas fa-list"></i> Kết quả: @Model.Count bản ghi</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr><th>Biển số</th><th>Loại xe</th><th>Thời gian vào</th><th>Thời gian ra</th><th>Thời lượng</th><th>Phí</th><th>Loại vé</th></tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">Chưa có lịch sử gửi xe.</td></tr>
                    }
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td class="fw-bold">@log.PlateNumber</td>
                            <td>@(log.VehicleType == "Car" ? "🚗 Ô Tô" : "🏍️ Xe Máy")</td>
                            <td>@log.TimeIn.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(log.TimeOut?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                            <td>
                                @if (log.TimeOut.HasValue)
                                {
                                    var duration = log.TimeOut.Value - log.TimeIn;
                                    @($"{(int)duration.TotalHours}h {duration.Minutes}m")
                                }
                                else
                                { <span class="badge badge-status-inside">Đang trong bãi</span> }
                            </td>
                            <td>@(log.Fee.HasValue ? $"{log.Fee:N0} VND" : "—")</td>
                            <td>
                                @if (log.IsMonthlyPass)
                                { <span class="badge bg-info">Vé tháng</span> }
                                else
                                { <span class="badge bg-secondary">Vãng lai</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
