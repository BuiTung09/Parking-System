@model List<MonthlyPass>
@{ ViewData["Title"] = "Vé tháng của tôi"; }

<h3 class="fw-bold mb-4"><i class="fas fa-id-card"></i> Vé tháng của tôi</h3>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="fas fa-id-card fa-4x mb-3 d-block"></i>
        <p>Chưa có vé tháng nào. Hãy đăng ký xe trước rồi mua vé tháng.</p>
        <a asp-action="MyVehicles" class="btn btn-primary">Quản lý xe</a>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr><th>Biển số</th><th>Loại xe</th><th>Ngày BĐ</th><th>Ngày HH</th><th>Giá</th><th>Trạng thái</th><th>Hành động</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var pass in Model)
                        {
                            <tr>
                                <td class="fw-bold">@pass.Vehicle?.PlateNumber</td>
                                <td>@(pass.Vehicle?.VehicleType == "Car" ? "🚗 Ô Tô" : "🏍️ Xe Máy")</td>
                                <td>@pass.StartDate.ToString("dd/MM/yyyy")</td>
                                <td>@pass.EndDate.ToString("dd/MM/yyyy")</td>
                                <td>@pass.Price.ToString("N0") VND</td>
                                <td>
                                    @if (pass.Status == "Active" && pass.EndDate >= DateTime.Now)
                                    {
                                        var days = (pass.EndDate - DateTime.Now).Days;
                                        <span class="badge bg-success rounded-pill">Hoạt động (@days ngày)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger rounded-pill">Hết hạn</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="RenewPass" asp-route-vehicleId="@pass.VehicleId" class="btn btn-sm btn-outline-primary rounded-pill">
                                        <i class="fas fa-sync-alt"></i> Gia hạn
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
