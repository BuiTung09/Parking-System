@model TopUpWalletViewModel
@{ ViewData["Title"] = "Nạp tiền vào ví"; }

<h3 class="fw-bold mb-4"><i class="fas fa-plus-circle"></i> Nạp tiền vào ví</h3>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-primary text-white fw-bold"><i class="fas fa-wallet"></i> Thanh toán nạp ví</div>
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <i class="fas fa-wallet fa-3x text-primary"></i>
                    <div class="mt-3">
                        <h5 class="text-muted mb-1">Số dư hiện tại</h5>
                        <h3 class="fw-bold text-success">@Model.CurrentBalance.ToString("N0") VND</h3>
                    </div>
                </div>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

                <form asp-action="TopUpWallet" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Amount" class="form-label fw-bold"></label>
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            <button type="button" class="btn btn-outline-primary btn-sm rounded-pill" onclick="setAmount(50000)">50.000</button>
                            <button type="button" class="btn btn-outline-primary btn-sm rounded-pill" onclick="setAmount(100000)">100.000</button>
                            <button type="button" class="btn btn-outline-primary btn-sm rounded-pill" onclick="setAmount(200000)">200.000</button>
                            <button type="button" class="btn btn-outline-primary btn-sm rounded-pill" onclick="setAmount(500000)">500.000</button>
                        </div>
                        <div class="input-group">
                            <input asp-for="Amount" id="topUpAmount" class="form-control" type="number" min="10000" max="10000000" step="1000" />
                            <span class="input-group-text">VND</span>
                        </div>
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 p-3 bg-light rounded text-center">
                        <h5 class="text-muted mb-1">Số tiền thanh toán</h5>
                        <h3 class="fw-bold text-success" id="displayAmount">@Model.Amount.ToString("N0") VND</h3>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PaymentMethod" class="form-label fw-bold"></label>
                        <select asp-for="PaymentMethod" class="form-select">
                            <option value="EWallet">💳 Ví điện tử (MoMo, ZaloPay, ...)</option>
                            <option value="BankTransfer">🏦 Chuyển khoản ngân hàng</option>
                        </select>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-success fw-bold py-2">
                            <i class="fas fa-credit-card"></i> THANH TOÁN
                        </button>
                    </div>
                </form>

                <div class="text-center mt-3">
                    <a asp-action="Wallet" class="text-decoration-none"><i class="fas fa-arrow-left"></i> Quay lại ví của tôi</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function setAmount(value) {
            document.getElementById('topUpAmount').value = value;
            updateDisplay();
        }
        function updateDisplay() {
            var val = parseInt(document.getElementById('topUpAmount').value || '0', 10);
            document.getElementById('displayAmount').innerText = val.toLocaleString('vi-VN') + ' VND';
        }
        document.getElementById('topUpAmount').addEventListener('input', updateDisplay);
    </script>
}
