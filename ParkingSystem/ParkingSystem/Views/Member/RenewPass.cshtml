@model RenewPassViewModel
@{ ViewData["Title"] = "Gia hạn vé tháng"; }

<h3 class="fw-bold mb-4"><i class="fas fa-sync-alt"></i> Gia hạn vé tháng</h3>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-primary text-white fw-bold"><i class="fas fa-info-circle"></i> Thông tin phương tiện</div>
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    @if (Model.VehicleType == "Car")
                    { <i class="fas fa-car fa-3x text-danger"></i> }
                    else
                    { <i class="fas fa-motorcycle fa-3x text-success"></i> }
                    <div class="plate-badge mx-auto mt-3">@Model.PlateNumber</div>
                </div>

                @if (Model.CurrentPass != null)
                {
                    <div class="alert alert-info small">
                        <i class="fas fa-info-circle"></i> Vé hiện tại hết hạn: <strong>@Model.CurrentPass.EndDate.ToString("dd/MM/yyyy")</strong>.
                        Vé mới sẽ bắt đầu từ ngày tiếp theo.
                    </div>
                }

                <div class="mb-3 p-3 bg-light rounded text-center">
                    <h5 class="text-muted mb-1">Phí vé tháng</h5>
                    <h3 class="fw-bold text-success">@Model.Price.ToString("N0") VND</h3>
                    <small class="text-muted">(Thời hạn: 1 tháng)</small>
                </div>

                <div class="mb-3 p-3 rounded d-flex justify-content-between align-items-center" style="background: #eef6ff;">
                    <span class="fw-bold"><i class="fas fa-wallet text-primary me-1"></i> Số dư ví</span>
                    <span class="fw-bold @(Model.WalletBalance >= Model.Price ? "text-success" : "text-danger")">@Model.WalletBalance.ToString("N0") VND</span>
                </div>

                @if (Model.WalletBalance < Model.Price)
                {
                    <div class="alert alert-warning small">
                        <i class="fas fa-exclamation-triangle"></i> Số dư ví không đủ. Vui lòng nạp thêm
                        <strong>@((Model.Price - Model.WalletBalance).ToString("N0")) VND</strong>.
                    </div>
                    <div class="d-grid">
                        <a asp-action="TopUpWallet" class="btn btn-warning fw-bold py-2">
                            <i class="fas fa-plus-circle"></i> NẠP TIỀN VÀO VÍ
                        </a>
                    </div>
                }
                else
                {
                    <form asp-action="RenewPass" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="VehicleId" />
                        <input type="hidden" asp-for="PlateNumber" />
                        <input type="hidden" asp-for="VehicleType" />
                        <input type="hidden" asp-for="Price" />

                        <div class="d-grid">
                            <button type="submit" class="btn btn-success fw-bold py-2" onclick="return confirm('Xác nhận trừ @Model.Price.ToString("N0") VND từ ví để gia hạn vé tháng?');">
                                <i class="fas fa-wallet"></i> THANH TOÁN BẰNG VÍ
                            </button>
                        </div>
                    </form>
                }

                <div class="text-center mt-3">
                    <a asp-action="MyPasses" class="text-decoration-none"><i class="fas fa-arrow-left"></i> Quay lại danh sách vé</a>
                </div>
            </div>
        </div>
    </div>
</div>
