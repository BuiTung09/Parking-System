@model TopUpQrViewModel
@{
    ViewData["Title"] = "Quét mã QR nạp ví";
    var methodLabel = Model.PaymentMethod == "BankTransfer" ? "Chuyển khoản ngân hàng" : "Ví điện tử (MoMo, ZaloPay, ...)";
}

<h3 class="fw-bold mb-4"><i class="fas fa-qrcode"></i> Thanh toán nạp ví</h3>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-primary text-white fw-bold"><i class="fas fa-qrcode"></i> Quét mã QR để chuyển tiền</div>
            <div class="card-body p-4">
                <div class="text-center mb-3">
                    <h5 class="text-muted mb-1">Số tiền cần chuyển</h5>
                    <h3 class="fw-bold text-success">@Model.Amount.ToString("N0") VND</h3>
                    <span class="badge bg-light text-dark border">@methodLabel</span>
                </div>

                <div class="text-center mb-3">
                    <img src="@Model.QrImageUrl" alt="Mã QR thanh toán" class="img-fluid border rounded p-2 bg-white shadow-sm" width="280" height="280" />
                    <p class="small text-muted mt-2 mb-0">Mở app ngân hàng / ví điện tử và quét mã QR</p>
                </div>

                <div class="p-3 bg-light rounded mb-4 small">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Người nhận</span>
                        <span class="fw-bold">@Model.AccountName</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">@(Model.PaymentMethod == "BankTransfer" ? "Ngân hàng" : "Ví")</span>
                        <span class="fw-bold">@Model.BankName</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">@(Model.PaymentMethod == "BankTransfer" ? "Số tài khoản" : "Số điện thoại")</span>
                        <span class="fw-bold font-monospace">@Model.AccountNumber</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Số tiền</span>
                        <span class="fw-bold text-success">@Model.Amount.ToString("N0") VND</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Nội dung CK</span>
                        <span class="fw-bold font-monospace">@Model.TransferContent</span>
                    </div>
                </div>

                <div class="alert alert-info small">
                    <i class="fas fa-info-circle"></i> Sau khi chuyển tiền thành công, bấm <strong>Hoàn thành</strong> để cộng tiền vào ví.
                </div>

                <form asp-action="CompleteTopUp" method="post" class="d-grid">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="paymentId" value="@Model.PaymentId" />
                    <button type="submit" class="btn btn-success fw-bold py-2"
                            onclick="return confirm('Bạn đã chuyển tiền thành công? Hệ thống sẽ cộng tiền vào ví.');">
                        <i class="fas fa-check-circle"></i> HOÀN THÀNH
                    </button>
                </form>

                <div class="text-center mt-3">
                    <a asp-action="TopUpWallet" class="text-decoration-none"><i class="fas fa-arrow-left"></i> Hủy và chọn lại</a>
                </div>
            </div>
        </div>
    </div>
</div>
